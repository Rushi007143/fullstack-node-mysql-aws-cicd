[Unit]
Description=Node.js MySQL Backend
After=network.target mysql.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/var/www/fullstack-app/backend/current
EnvironmentFile=/var/www/fullstack-app/shared/.env
ExecStart=/usr/bin/node src/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
